<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>it.dontesta.fiscohub</id>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>MIT</project_license>
    <name>DonTesta FiscoHub</name>
    <summary>Visualizzatore open-source e cross-platform per fatture elettroniche XML e Corrispettivi</summary>

    <developer id="it.dontesta">
        <name>Antonio Musarra</name>
    </developer>

    <categories>
        <category>Office</category>
        <category>Finance</category>
    </categories>

    <description>
        <p>
            DonTesta FiscoHub consente di importare, organizzare e visualizzare le fatture elettroniche e corrispettivi in modo semplice,
            veloce ed efficiente direttamente sul tuo desktop.
        </p>
        <p>
            Funzionalità principali:
        </p>
        <ul>
            <li>Supporto XML e file firmati digitalmente P7M (CAdES)</li>
            <li>Estrazione e verifica dettagliata dei certificati di firma X.509</li>
            <li>Gestione multi-azienda e classificazione automatica (Emesse / Ricevute)</li>
            <li>Dashboard analitica con KPI e grafici di fatturato e spesa</li>
            <li>Privacy totale: elaborazione 100% client-side e locale</li>
        </ul>
    </description>

    <!-- Associa espressamente il file .desktop generato da Tauri -->
    <launchable type="desktop-id">DonTestaFiscoHub.desktop</launchable>

    <!-- Corrisponde al campo Icon=dontesta-FiscoHub del file .desktop -->
    <icon type="stock">dontesta-FiscoHub</icon>

    <url type="homepage">https://www.dontesta.it</url>
    <url type="bugtracker">https://github.com/amusarra/dontesta-fisco-hub/issues</url>
    <url type="vcs-browser">https://github.com/amusarra/dontesta-fisco-hub</url>

    <content_rating type="oars-1.1" />

    <releases>
        <release version="1.0.0" date="2026-07-28">
            <description>
                <p>Prima release ufficiale di DonTesta FiscoHub.</p>
            </description>
        </release>
    </releases>

    <screenshots>
        <screenshot type="default">
            <caption>Dashboard analitica e gestione fatture</caption>
            <image>https://raw.githubusercontent.com/amusarra/dontesta-fisco-hub/docs/resources/images/screenshot-main.png</image>
        </screenshot>
    </screenshots>
</component>