{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DonTestaFatturaPA",
  "version": "1.0.0",
  "identifier": "it.dontesta.fatturapa",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "title": "DonTesta FatturaPA",
        "width": 800,
        "height": 600,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "skipTaskbar": true,
        "url": "splashscreen.html"
      },
      {
        "label": "main",
        "title": "DonTesta FatturaPA",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "center": true,
        "visible": false,
        "maximized": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2026 Antonio Musarra (dontesta.it)",
    "publisher": "Antonio Musarra",
    "shortDescription": "Visualizzatore open-source e cross-platform per fatture elettroniche XML (FatturaPA)",
    "longDescription": "DonTesta FatturaPA è un'applicazione open-source e cross-platform per visualizzare e gestire fatture elettroniche in formato XML (FatturaPA).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "10.13"
    }
  }
}
